<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/ontologies/sinso#"
     xml:base="http://www.semanticweb.org/ontologies/sinso"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/ontologies/sinso">
        <rdfs:comment>Specification of a high level ontology about software sustainability, and its coding in the OWL language. To be used in the development of sustainable systems.</rdfs:comment>
        <rdfs:isDefinedBy>Luisa Fernanda Restrepo Gutierrez</rdfs:isDefinedBy>
        <owl:versionInfo>1.0.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/ontologies/sinso#belongsTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#belongsTo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#Scale"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/sinso#TypeOfScale"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#belongsToMdfb1 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#belongsToMdfb1">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#Modifiability"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/sinso#Changeability"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#belongsToMdfb2 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#belongsToMdfb2">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#Modifiability"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/sinso#Stability"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#contributesTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#contributesTo">
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/sinso#Evolvability"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#hasImpact -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#hasImpact">
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/sinso#Dimension"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#hasIndicator -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#hasIndicator">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#Objective"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/sinso#Indicator"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#hasObjective -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#hasObjective">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#QualityAttribute"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/sinso#Objective"/>
        <owl:propertyDisjointWith rdf:resource="http://www.semanticweb.org/ontologies/sinso#specifiedFor"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#hasQAS -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#hasQAS">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#Domain"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/sinso#QualityAttribute"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#hasScale -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#hasScale">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#Measurement"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/sinso#Scale"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#involves -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#involves">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#QualityAttribute"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#isComposedOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#isComposedOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#QualityAttribute"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#isRelatedTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#isRelatedTo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#QualityAttribute"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/sinso#Dimension"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#mayHas -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#mayHas">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#QualityAttribute"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/sinso#Compatibility"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/sinso#FunctionalSuitability"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/sinso#Performance"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/sinso#Reliability"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/sinso#Security"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/sinso#Usability"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#obtains -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#obtains">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#Indicator"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/sinso#Measure"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#shouldHas -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#shouldHas">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#QualityAttribute"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/sinso#Evolvability"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/sinso#Maintainability"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/sinso#Portability"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/sinso#Scalability"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#specifiedFor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#specifiedFor">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#QualityAttribute"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/sinso#Domain"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#uses -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#uses">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#Measure"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/sinso#Measurement"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/ontologies/sinso#description -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#description">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#Changeability"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#Compatibility"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#EnergyEfficiency"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#Evolvability"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#FunctionalSuitability"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#Maintainability"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#Performance"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#Portability"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#Reliability"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#Scalability"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#Security"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#Stability"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#Usability"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#identifier -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#identifier">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#Domain"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#identifierIndicator -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#identifierIndicator">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#Indicator"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#identifierMeasure -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#identifierMeasure">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#Measure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#identifierMeasurement -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#identifierMeasurement">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#Measurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#identifierObjective -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#identifierObjective">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#Objective"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#identifierScale -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#identifierScale">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#Scale"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#identifierTypeOfScale -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#identifierTypeOfScale">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#TypeOfScale"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#name -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#name">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#Domain"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#nameIndicator -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#nameIndicator">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#Indicator"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#nameMeasure -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#nameMeasure">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#Measure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#nameMeasurement -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#nameMeasurement">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#Measurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#nameObjective -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#nameObjective">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#Objective"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#nameScale -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#nameScale">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#Scale"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#nameTypeOfScale -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#nameTypeOfScale">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#TypeOfScale"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#objective -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#objective">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#Domain"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#value -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/sinso#value">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/sinso#Scale"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/ontologies/sinso#Accountability -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/sinso#Accountability">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/sinso#Security"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#Adaptability -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/sinso#Adaptability">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/sinso#Portability"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/ontologies/sinso#Replaceability"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#Analysability -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/sinso#Analysability">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/sinso#Maintainability"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/sinso#contributesTo"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/sinso#Evolvability"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#AppropriatenessRecognizability -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/sinso#AppropriatenessRecognizability">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/sinso#Usability"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#Authenticity -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/sinso#Authenticity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/sinso#Security"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#Capacity -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/sinso#Capacity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/sinso#Performance"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#Changeability -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/sinso#Changeability"/>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#CoExistence -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/sinso#CoExistence">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/sinso#Compatibility"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/ontologies/sinso#Interoperability"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#Compatibility -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/sinso#Compatibility">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/sinso#hasImpact"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/sinso#Economical"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/sinso#hasImpact"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/sinso#Social"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/sinso#hasImpact"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/sinso#Technical"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#Confidentiality -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/sinso#Confidentiality">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/sinso#Security"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#Dimension -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/sinso#Dimension"/>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#Domain -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/sinso#Domain"/>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#Economical -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/sinso#Economical">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/sinso#Dimension"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#EnergyEfficiency -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/sinso#EnergyEfficiency">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/sinso#ResourceUtilization"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#Environmental -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/sinso#Environmental">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/sinso#Dimension"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#Evolvability -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/sinso#Evolvability">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/sinso#hasImpact"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/sinso#Technical"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#FunctionalAppropriateness -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/sinso#FunctionalAppropriateness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/sinso#FunctionalSuitability"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/ontologies/sinso#FunctionalCorrectness"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#FunctionalCorrectness -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/sinso#FunctionalCorrectness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/sinso#FunctionalSuitability"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/sinso#FunctionalSuitability -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/sinso#FunctionalSuitability">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/sinso#hasImpact"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/sinso#Economical"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/sinso#hasImpact"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/sinso#Technical"/>
            </owl:Restriction>
